# Copy this file to .env.local and fill in your keys.
ANTHROPIC_API_KEY=
# Only needed if your API key isn't scoped to a workspace (the error message says so).
# Find the ID (it starts with wrkspc_) at platform.claude.com, Settings, Workspaces.
ANTHROPIC_WORKSPACE_ID=
ELEVENLABS_API_KEY=
# ElevenLabs voice for the tutor. Pick a Mexican Spanish voice in the
# ElevenLabs Voice Library, add it to "My Voices", and paste its voice ID here.
ELEVENLABS_VOICE_ID=
